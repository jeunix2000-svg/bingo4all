{
  "name": "yfc-ai-platform",
  "version": "1.1.0",
  "private": true,
  "description": "YFC AI Knowledge Platform — monorepo (Wiki is Module 1)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm --workspace @yfc/point-service test && npm --workspace @yfc/wiki-module test",
    "db:migrate": "docker compose run --rm flyway",
    "dev:db": "docker compose up -d db",
    "start:points": "npm --workspace @yfc/point-service start",
    "start:wiki": "npm --workspace @yfc/wiki-module start",
    "smoke": "node --import tsx packages/wiki-module/scripts/smoke.mjs",
    "smoke:local": "python3 packages/wiki-module/scripts/run-smoke-local.py"
  },
  "engines": {
    "node": ">=20"
  }
}