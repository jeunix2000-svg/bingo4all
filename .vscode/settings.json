{
  // 保存时自动触发 — 需要安装扩展 "Run on Save" (emeraldwalk.RunOnSave)
  //
  // 模式 A：本地开发机 → 远程服务器（scp/rsync 同步）
  //   "cmd": "bash ${workspaceFolder}/deploy.sh"
  //
  // 模式 B：已通过 Cursor SSH 远程直连服务器编辑（当前场景）
  //   文件已在 /var/www/html，保存后只需修复 Apache 权限
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.(html|css|js)$",
        "cmd": "bash ${workspaceFolder}/fix-on-save.sh"
      }
    ]
  },
  "files.autoSave": "off"
}
